# Copy to .env (or run `npm run env:init` to generate one with random secrets).
# Every value marked CHANGE_ME must be replaced. Never commit a real .env file.

NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose publishes it on host port 55432 to avoid clashing with a local Postgres)
DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_NAME=merchant_platform
DATABASE_USER=merchant_app
DATABASE_PASSWORD=CHANGE_ME
DATABASE_SSL=false

# Redis / BullMQ (docker compose publishes it on host port 56379)
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=

# JWT: use at least 32 random characters
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=merchant-payments-platform
JWT_AUDIENCE=merchant-payments-api

# AES-256-GCM key for field-level encryption: 32 random bytes, base64 encoded
FIELD_ENCRYPTION_KEY=CHANGE_ME

# Risk review worker
RISK_REVIEW_MAX_ATTEMPTS=5
RISK_REVIEW_BACKOFF_MS=2000
RISK_PROVIDER_TRANSIENT_FAILURE_RATE=0.2
RISK_PROVIDER_LATENCY_MS=300

# Transactional outbox relay
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50

# Shared HMAC secret for signed risk-provider webhooks (at least 32 random characters)
RISK_WEBHOOK_SECRET=CHANGE_ME
RISK_WEBHOOK_TOLERANCE_SECONDS=300

# Login brute-force protection
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_SECONDS=60

# Optional: bootstrap users for local development (used only by `npm run seed`)
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_REVIEWER_EMAIL=reviewer@example.test
SEED_REVIEWER_PASSWORD=CHANGE_ME
SEED_SALES_EMAIL=sales@example.test
SEED_SALES_PASSWORD=CHANGE_ME
